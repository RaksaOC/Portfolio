# "Request CV" email (src/api/request-cv.js)
# Copy to .env.local for `npm run dev` and for self-hosting (`npm start` reads it too);
# on Vercel, add the same keys in Settings → Environment Variables.

# Mailbox that sends the resume (Gmail works; use an App Password, not your normal password)
SMTP_USER=
SMTP_PASS=

# Optional
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CV_FROM_NAME=Ory Chanraksa
# CV_NOTIFY_TO=            # who gets "someone requested your CV" (defaults to SMTP_USER)
# CV_PUBLIC_URL=https://chanraksa.com

# AI chat (src/api/chat.js) — Google Gemini. The key stays on the server; the browser only calls /api/chat.
GEMINI_API_KEY=
# Optional
# GEMINI_MODEL=gemini-3.1-flash-lite   (optional; comma-separate several to try in order)
# CHAT_ALLOWED_ORIGINS=https://chanraksa.com,https://www.chanraksa.com

# Optional: set to true to make the chat use canned demo answers instead of /api/chat (no Gemini calls).
# Read at build time, so set it in Vercel too and redeploy after changing it.
# VITE_CHAT_MOCK=true
